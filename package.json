{
  "name": "portfolio-dashboard-monorepo",
  "version": "3.9.4",
  "private": true,
  "license": "MIT",
  "author": "Rajat Bansal",
  "scripts": {
    "dev": "pnpm -r install && pnpm -r --parallel run dev",
    "dev:frontend": "pnpm --filter @portfolio/frontend dev",
    "dev:backend": "pnpm --filter @portfolio/backend dev",
    "build": "pnpm -r run build",
    "build:frontend": "pnpm --filter @portfolio/frontend build",
    "build:backend": "pnpm --filter @portfolio/backend build",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "clean": "pnpm -r run clean",
    "knip": "knip"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "workbox-build": "7.4.1",
      "workbox-window": "7.4.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "knip": "^6.14.2"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
