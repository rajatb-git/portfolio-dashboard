# Backend environment configuration.
# Copy this file to `.env` in the same folder and fill in the values:
#   cp packages/backend/.env.example packages/backend/.env
# `.env` is gitignored — never commit real keys.

# --- MongoDB (required) -----------------------------------------------------
# Connection string for the MongoDB instance this backend stores everything in
# (holdings, accounts, transactions, config, market-data caches). Point this
# at your own MongoDB server — the app does not run without it. If the
# backend runs inside a container (see docker-compose.yml), this must be the
# Mongo host's LAN address — "localhost"/"127.0.0.1" here resolves to the
# backend's own container, not your Mongo host.
MONGO_URI=mongodb://user:password@your-mongo-host:27017

# Logical database name for real data. Demo Mode automatically uses
# "<this>_demo" on the same server — no separate variable for it. Optional
# (defaults to portfolio_dashboard). MongoDB creates the database and its
# collections automatically on first write — no manual setup needed.
MONGO_DB_NAME=portfolio_dashboard

# --- Finnhub (required) -----------------------------------------------------
# Free API key from https://finnhub.io — powers quotes, recommendations, news,
# metrics, earnings, insider transactions, and the IPO calendar.
FINN_HUB_API=https://finnhub.io/api/v1
FINN_HUB_API_KEY=your_finnhub_api_key_here

# Sustained requests/second ceiling. The Finnhub free tier allows ~30 req/s;
# 8 is a safe default that leaves headroom. Optional (defaults to 8).
FINN_HUB_RATE_LIMIT=8

# --- Server (optional) ------------------------------------------------------
# Port the Koa backend listens on. Defaults to 3001.
# PORT=3001

# Working-directory anchor for scheduled backup zips, logs, and the demo-mode
# flag — no application data lives here (that's all in MongoDB now). Must end
# in "storage". Defaults to ./storage under the backend working directory.
# STORAGE_DIR=./storage

# NASDAQ (price history) needs no key. AI provider keys (Claude / Gemini) and
# the Ollama host are configured in-app under Settings, not here — nothing
# personal or secret is ever read from this file for AI.
