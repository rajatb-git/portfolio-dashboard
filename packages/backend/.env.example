# Backend environment variables
# Copy this file to `.env` and fill in your values.
# When running via docker-compose, this file is loaded from packages/backend/.env (optional).

# Port the backend listens on (default 3001)
PORT=3001

# Finnhub API — required for live market data
# Sign up at https://finnhub.io to get a free API key
FINN_HUB_API=https://finnhub.io/api/v1
FINN_HUB_API_KEY=your_finnhub_api_key_here
