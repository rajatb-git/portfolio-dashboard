{
  "name": "@portfolio/backend",
  "version": "3.9.5",
  "description": "",
  "main": "dist",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "pnpm biome format .",
    "format:fix": "pnpm biome format --write .",
    "fix:all": "pnpm run lint:fix && pnpm run format:fix",
    "start": "node ./dist/server.js",
    "do": "npm run clean && npm run build && npm start",
    "dev": "nodemon --ignore '*.json' src/server.ts"
  },
  "author": "Rajat Bansal",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
