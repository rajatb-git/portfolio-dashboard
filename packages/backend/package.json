{
  "name": "@portfolio/backend",
  "version": "4.6.0",
  "description": "",
  "main": "dist",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "pnpm biome format .",
    "format:fix": "pnpm biome format --write .",
    "fix:all": "pnpm run lint:fix && pnpm run format:fix",
    "start": "node ./dist/server.js",
    "do": "npm run clean && npm run build && npm start",
    "dev": "nodemon --ignore '*.json' src/server.ts",
    "migrate:mongo": "npm run build && node ./dist/scripts/migrateToMongo.js"
  },
  "author": "Rajat Bansal",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.17.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "archiver": "^8.0.0",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.0",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^9.0.0",
    "moment": "^2.30.1",
    "mongodb": "^7.5.0",
    "mqtt": "^5.15.2",
    "unzipper": "^0.12.5",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/archiver": "^8.0.0",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^26.2.0",
    "@types/unzipper": "^0.10.11",
    "nodemon": "^3.1.14",
    "typescript": "7.0.2"
  }
}
