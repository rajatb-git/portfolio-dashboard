{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["@biomejs/biome"]
    },
    "packages/frontend": {
      "entry": [
        "src/App.tsx",
        "src/pages/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/backend": {
      "entry": [
        "src/server.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
